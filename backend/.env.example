APP_ENV=local
AUTO_MIGRATE=true               # API and crawler apply migrations on start; production sets false
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://watch:watch@localhost:5432/watch?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000
CACHE_TTL=60s

# Crawler
CRAWL_SOURCES=            # empty = all enabled sources; e.g. jackroad,hourstack
CRAWL_CONCURRENCY=3
CRAWL_MAX_PAGES=200
CRAWL_RATE_LIMIT_MS=1500
CRAWL_DEACTIVATE_STALE_AFTER=72h
CRAWL_PROXY_URL=          # optional forward proxy (Chrono24)
# Headless render service for Chrono24 (see docs/BROWSERLESS.md)
CRAWL_RENDER_SERVICE_URL=       # e.g. https://production-sfo.browserless.io (or a self-hosted *.run.app URL with CRAWL_RENDER_MODE=content)
CRAWL_RENDER_SERVICE_TOKEN=     # Browserless TOKEN
CRAWL_RENDER_MODE=browserless   # browserless (POST /smart-scrape) | content (POST /content, self-hosted) | get
CRAWL_RENDER_LAUNCH_JSON=       # content mode only, e.g. {"stealth":true,"args":["--proxy-server=http://host:port"]}
CRAWL_RENDER_EXTRA_QUERY=       # browserless.io options, e.g. proxy=residential&proxyCountry=de&stealth=true
CRAWL_RENDER_USE_IDTOKEN=       # default: true for *.run.app URLs (Cloud Run IAM), false elsewhere
ALAPOWER_FETCH_DETAILS=false   # Hourstack + RD Watch: also fetch product pages (material/diameter)

# Chrono24 budget (each list page is one rendered page = one Browserless unit)
CHRONO24_BRANDS=rolex,omega,iwc,audemarspiguet,patekphilippe
CHRONO24_MAX_PAGES=3            # pages per brand per night, 120 listings each

# eBay Browse API (https://developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACES=EBAY_US

# FX (USD base; free, keyless)
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
