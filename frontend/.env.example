# Server-side URL of the Go API (Cloud Run). Never exposed to the browser.
API_URL=http://localhost:8080
# Public site URL used for canonical links / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Amplitude browser key (public). Leave empty to disable analytics; defaults to the production key in src/lib/analytics.ts
NEXT_PUBLIC_AMPLITUDE_API_KEY=
